      "outputs": [],
      "source": [
        "def supervisor_node(state: SupervisorState) -> dict:\n",
        "    sys_prompt = \"You are a supervisor routing requests to the appropriate specialist. Choose 'math' if the question requires mathematical calculation, or 'handbook' if the question asks for a fact from the Olo Academy handbook. Respond with ONLY 'math' or 'handbook'. No other text.\"\n",
        "    user_prompt = f\"Question: {state['question']}\"\n",
        "    reply = chat(sys_prompt, user_prompt, max_new_tokens=50).strip().lower()\n",
        "    route = \"math\" if \"math\" in reply else \"handbook\"\n",
        "    return {\"route\": route}\n",
        "\n",
        "def router(state: SupervisorState) -> str:\n",
        "    return state[\"route\"]\n",
        "\n",
        "builder = StateGraph(SupervisorState)\n",
        "builder.add_node(\"supervisor\", supervisor_node)\n",
        "builder.add_node(\"math\", math_specialist)\n",
        "builder.add_node(\"handbook\", handbook_specialist)\n",
        "\n",
        "builder.set_entry_point(\"supervisor\")\n",
        "\n",
        "builder.add_conditional_edges(\n",
        "    \"supervisor\",\n",
        "    router,\n",
        "    {\n",
        "        \"math\": \"math\",\n",
        "        \"handbook\": \"handbook\"\n",
        "    }\n",
        ")\n",
        "\n",
        "builder.add_edge(\"math\", END)\n",
        "builder.add_edge(\"handbook\", END)\n",
        "\n",
        "multi_agent = builder.compile()"
      ]
    },
