      "source": [
        "from typing import TypedDict\n",
        "\n",
        "class SupervisorState(TypedDict):\n",
        "    question: str\n",
        "    route: str\n",
        "    final_answer: str\n",
        "\n",
        "def math_specialist(state: SupervisorState) -> dict:\n",
        "    # Ask LLM for ONE calculator expression\n",
        "    sys_msg1 = \"You are a math helper. Extract or construct a single mathematical expression from the user's question. Respond with ONLY the math expression. No other text.\"\n",
        "    user_msg1 = f\"Question: {state['question']}\"\n",
        "    expr = chat(sys_msg1, user_msg1, max_new_tokens=50).strip().split(\"\\n\")[0]\n",
        "\n",
        "    # Run tool_calculator\n",
        "    result = tool_calculator(expr)\n",
        "\n",
        "    # Ask LLM to compose a one-sentence final answer\n",
        "    sys_msg2 = \"You are a helpful assistant. Formulate a final one-sentence answer using the math result provided.\"\n",
        "    user_msg2 = f\"Question: {state['question']}\\nMath result: {result}\"\n",
        "    answer = chat(sys_msg2, user_msg2, max_new_tokens=100)\n",
        "\n",
        "    return {\"final_answer\": answer}\n",
        "\n",
        "def handbook_specialist(state: SupervisorState) -> dict:\n",
        "    # Ask LLM for ONE handbook key\n",
        "    sys_msg1 = \"You are a lookup assistant. Based on the question, choose ONE of these keys: 'cohort size', 'tuition per student', 'USD exchange rate', 'program length', 'lead instructor'. Respond with ONLY that key. No other text.\"\n",
        "    user_msg1 = f\"Question: {state['question']}\"\n",
        "    key = chat(sys_msg1, user_msg1, max_new_tokens=50).strip().split(\"\\n\")[0]\n",
        "\n",
        "    # Run tool_kb_lookup\n",
        "    result = tool_kb_lookup(key)\n",
        "\n",
        "    # Ask LLM to compose a one-sentence final answer\n",
        "    sys_msg2 = \"You are a helpful assistant. Formulate a final one-sentence answer using the fact provided.\"\n",
        "    user_msg2 = f\"Question: {state['question']}\\nFact found: {result}\"\n",
        "    answer = chat(sys_msg2, user_msg2, max_new_tokens=100)\n",
        "\n",
        "    return {\"final_answer\": answer}"
      ]
    },
