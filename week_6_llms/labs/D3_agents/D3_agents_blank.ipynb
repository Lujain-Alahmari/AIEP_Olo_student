   "source": [
    "# ────────────────────────────────────────────────────────────────────\n",
    "# 1) supervisor_node: ask chat() for ONE word -- \"math\" or \"handbook\".\n",
    "# 2) Normalize: route = \"math\" if \"math\" in reply.lower() else \"handbook\".\n",
    "# 3) Return {\"route\": route}.\n",
    "# 4) router(state): return state[\"route\"]  # drives the conditional edge\n",
